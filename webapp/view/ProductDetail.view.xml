<mvc:View
    controllerName="com.sapwebshop2026.sapwebshop.controller.ProductDetail"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    displayBlock="true">

    <Page id="productDetailPage" showHeader="true" backgroundDesign="Solid">

        <!-- Shell bar -->
        <customHeader>
            <Bar class="rsShellBar">
                <contentLeft>
                    <core:Fragment fragmentName="com.sapwebshop2026.sapwebshop.view.ShellBarLeftNav" type="XML"/>
                </contentLeft>
                <contentMiddle>
                    <core:InvisibleText id="pdpSearchLabel" text="{i18n>searchAriaLabel}"/>
                    <SearchField
                        id="pdpSearchField"
                        placeholder="{i18n>searchPlaceholder}"
                        tooltip="{i18n>searchAriaLabel}"
                        ariaLabelledBy="pdpSearchLabel"
                        width="400px"
                        search="onSearch"
                        class="rsShellSearch"/>
                </contentMiddle>
                <contentRight>
                    <core:Fragment fragmentName="com.sapwebshop2026.sapwebshop.view.ShellBarRight" type="XML"/>
                </contentRight>
            </Bar>
        </customHeader>

        <content>

            <!-- Product header -->
            <HBox
                class="sapUiMediumMarginBeginEnd sapUiSmallMarginBottom sapUiMediumMarginTop"
                justifyContent="SpaceBetween"
                alignItems="Start">
                <VBox>
                    <Title id="productName" text="{ProductName}" level="H2"/>
                    <HBox alignItems="Center" class="sapUiTinyMarginTop">
                            <VBox class="rsProductDetailId sapUiSmallMarginEnd">
                            <Text text="{= ${i18n>articleNo} + ' ' + ${Material}}"/>
                        </VBox>
                    </HBox>
                </VBox>
                <VBox alignItems="End">
                    <!-- Wishlist heart -->
                    <Button
                        id="pdpWishlistBtn"
                        icon="sap-icon://heart-2"
                        type="Transparent"
                        tooltip="{i18n>addToWishlist}"
                        press="onToggleWishlist"
                        class="rsCardHeartBtn rsPdpHeartBtn sapUiTinyMarginBottom"/>
                    <VBox class="rsProductPriceLabel">
                        <Text text="{i18n>listPriceNet}"/>
                    </VBox>
                    <VBox class="rsProductPriceMain">
                        <Title id="productPrice" text="{
                            parts: [
                                { path: 'NetPriceAmount' },
                                { path: 'TransactionCurrency' }
                            ],
                            formatter: '.formatter.formatPrice'
                        }" level="H1"/>
                    </VBox>
                    <VBox class="rsProductPriceLabel">
                        <Text text="{i18n>plusVatShipping}"/>
                    </VBox>
                </VBox>
            </HBox>

            <!-- Main content: Image | Configuration panel -->
            <HBox
                class="sapUiMediumMarginBeginEnd sapUiMediumMarginBottom rsDetailLayout"
                alignItems="Start"
                wrap="Wrap">

                <VBox class="rsDetailImageColumn sapUiSmallMarginEnd">
                    <VBox id="thumbnailContainer" class="rsDetailImageThumbs"/>

                    <Panel class="rsDetailMainImagePanel">
                        <Image
                            id="mainProductImage"
                            src="{ProductPictureUrl}"
                            alt="{ProductName}"
                            tooltip="{ProductName}"
                            width="100%"
                            class="rsDetailMainImage"
                            error="onImageError"/>
                    </Panel>
                </VBox>

                <!-- Configuration panel -->
                <Panel class="rsDetailConfigPanel" backgroundDesign="Transparent">
                    <headerToolbar>
                        <Toolbar>
                            <Title text="{i18n>configAndOrder}" level="H4"/>
                        </Toolbar>
                    </headerToolbar>
                    <content>
                        <VBox class="sapUiSmallMarginBeginEnd sapUiSmallMarginBottom">

                            <!-- Price overview -->
                            <HBox justifyContent="SpaceBetween" class="sapUiSmallMarginTop">
                                <Text text="{i18n>basePriceNet}"/>
                                <Title id="basePriceText" text="{
                                    parts: [
                                        { path: 'NetPriceAmount' },
                                        { path: 'TransactionCurrency' }
                                    ],
                                    formatter: '.formatter.formatPrice'
                                }" level="H5" class="rsPriceHighlight"/>
                            </HBox>

                            <!-- Buy box -->
                            <VBox class="rsPdpBuyBox sapUiSmallMarginTop">
                                <HBox class="rsPdpQtyLine" alignItems="Center">
                                    <Label text="{i18n>qtyLabel}" class="rsPdpQtyLabel"/>
                                    <StepInput
                                        id="pdpQtyInput"
                                        min="1"
                                        max="99"
                                        value="1"
                                        width="130px"/>
                                </HBox>
                                <Button
                                    id="addToCartBtn"
                                    text="{i18n>addToCartFull}"
                                    type="Emphasized"
                                    icon="sap-icon://cart"
                                    enabled="{= ${addToShoppingCart_ac} !== false}"
                                    press="onAddToCart"
                                    width="100%"
                                    class="rsPdpCartBtn sapUiSmallMarginTop"/>
                            </VBox>

                            <!-- Delivery info -->
                            <VBox class="sapUiSmallMarginTop rsDeliveryInfo">
                                <HBox alignItems="Center" class="sapUiTinyMarginBottom">
                                    <core:Icon src="sap-icon://accept" color="Positive" class="sapUiTinyMarginEnd"/>
                                    <Text text="{i18n>deliveryInStock}"/>
                                </HBox>
                                <HBox alignItems="Center" class="sapUiTinyMarginBottom">
                                    <core:Icon src="sap-icon://shipping-status" class="sapUiTinyMarginEnd"/>
                                    <Text text="{i18n>deliveryFreeShipping}"/>
                                </HBox>
                                <HBox alignItems="Center" class="sapUiTinyMarginBottom">
                                    <core:Icon src="sap-icon://wrench" class="sapUiTinyMarginEnd"/>
                                    <Text text="{i18n>deliveryInstallation}"/>
                                </HBox>
                                <HBox alignItems="Center">
                                    <core:Icon src="sap-icon://locked" class="sapUiTinyMarginEnd"/>
                                    <Text text="{i18n>deliveryWarranty}"/>
                                </HBox>
                            </VBox>

                        </VBox>
                    </content>
                </Panel>
            </HBox>

            <!-- Tabs -->
            <VBox class="sapUiMediumMarginBeginEnd sapUiMediumMarginBottom">
                <IconTabBar id="productTabs" expanded="true" selectedKey="desc">
                    <items>
                        <IconTabFilter text="{i18n>tabDescription}" key="desc">
                            <VBox class="sapUiSmallMarginTop">
                                <Text
                                    id="productDescription"
                                    text="{= ${ProductSalesDescription} ? ${ProductSalesDescription} : ${i18n>noDescription}}"
                                    wrapping="true"
                                    class="sapUiSmallMarginBottom"/>
                            </VBox>
                        </IconTabFilter>
                        <IconTabFilter text="{i18n>tabDownloads}" key="downloads">
                            <VBox class="sapUiSmallMarginTop">
                                                <HBox alignItems="Center" class="sapUiSmallMarginBottom">
                                    <core:Icon src="sap-icon://pdf-attachment" size="1.5rem" class="sapUiSmallMarginEnd"/>
                                    <Link text="{i18n>downloadDatasheet}" press="onDownload"/>
                                </HBox>
                            </VBox>
                        </IconTabFilter>
                    </items>
                </IconTabBar>
            </VBox>

            <!-- Bundle components (visible only for BOM products) -->
            <VBox
                id="bundleSection"
                class="sapUiMediumMarginBeginEnd sapUiMediumMarginBottom"
                visible="{detailModel>/hasBundleItems}">

                <Title
                    text="{i18n>bundleComponents}"
                    level="H3"
                    class="sapUiSmallMarginBottom"/>
                <Text
                    text="{i18n>bundleComponentsDesc}"
                    class="sapUiSmallMarginBottom"/>

                <List
                    id="bundleGrid"
                    items="{to_BundleItem}"
                    mode="None"
                    showNoData="false"
                    class="rsBundleGrid">

                    <CustomListItem type="Inactive">
                        <VBox class="rsBundleCard">
                            <VBox class="rsBundleCardImageWrap">
                                <Image
                                    src="{ProductPictureUrl}"
                                    alt="{ComponentDescription}"
                                    tooltip="{ComponentDescription}"
                                    width="100%"
                                    error="onBundleImageError"/>
                            </VBox>
                            <VBox class="rsBundleCardBody">
                                <VBox class="rsProductCardTitle">
                                    <Title text="{ComponentDescription}" level="H6" wrapping="true"/>
                                </VBox>
                                <VBox class="rsProductCardId">
                                    <Text text="{BillOfMaterialComponent}"/>
                                </VBox>
                            </VBox>
                        </VBox>
                    </CustomListItem>
                </List>
            </VBox>

        </content>
    </Page>
</mvc:View>
