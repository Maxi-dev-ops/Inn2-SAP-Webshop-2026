<mvc:View
    controllerName="com.sapwebshop2026.sapwebshop.controller.ProductDetail"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    displayBlock="true">

    <Page id="productDetailPage" showHeader="true" backgroundDesign="Solid">

        <!-- ═══════════════════════════════════════════════════════════
             SHELL BAR
             ═══════════════════════════════════════════════════════════ -->
        <customHeader>
            <Bar class="rsShellBar">
                <contentLeft>
                    <Button
                        icon="sap-icon://nav-back"
                        type="Transparent"
                        tooltip="Zurück"
                        press="onNavBack"
                        class="rsShellBtn"/>
                    <Button
                        icon="sap-icon://home"
                        text="Inn2 Shop"
                        type="Transparent"
                        press="onNavHome"
                        class="rsShellLogoBtn"/>
                </contentLeft>
                <contentMiddle>
                    <SearchField
                        placeholder="Produkte suchen..."
                        width="400px"
                        search="onSearch"
                        class="rsShellSearch"/>
                </contentMiddle>
                <contentRight>
                    <Button
                        icon="sap-icon://cart"
                        type="Transparent"
                        tooltip="Warenkorb"
                        press="onNavToCart"
                        class="rsShellBtn">
                        <customData>
                            <BadgeCustomData value="{= ${cartModel>/count} > 0 ? ${cartModel>/count} : ''}"/>
                        </customData>
                    </Button>
                </contentRight>
            </Bar>
        </customHeader>

        <content>

            <!-- ═══════════════════════════════════════════════════════
                 PRODUKT-KOPFZEILE  (Name | Preis)
                 ═══════════════════════════════════════════════════════ -->
            <HBox
                class="sapUiMediumMarginBeginEnd sapUiSmallMarginBottom sapUiMediumMarginTop"
                justifyContent="SpaceBetween"
                alignItems="Start">
                <VBox>
                    <Title id="productName" text="{ProductName}" level="H2"/>
                    <HBox alignItems="Center" class="sapUiTinyMarginTop">
                        <!-- ID-Wrapper → CSS .rsProductDetailId .sapMText -->
                        <VBox class="rsProductDetailId sapUiSmallMarginEnd">
                            <Text text="{= 'Art.-Nr. ' + ${Material}}"/>
                        </VBox>
                    </HBox>
                </VBox>
                <VBox alignItems="End">
                    <!-- Preis-Label-Wrapper → CSS .rsProductPriceLabel .sapMText -->
                    <VBox class="rsProductPriceLabel">
                        <Text text="Listenpreis (netto)"/>
                    </VBox>
                    <!-- Preis-Wrapper → CSS .rsProductPriceMain .sapMTitle -->
                    <VBox class="rsProductPriceMain">
                        <Title id="productPrice" text="{
                            parts: [
                                { path: 'NetPriceAmount' },
                                { path: 'TransactionCurrency' }
                            ],
                            formatter: '.formatter.formatPrice'
                        }" level="H1"/>
                    </VBox>
                    <VBox class="rsProductPriceLabel">
                        <Text text="zzgl. MwSt. &amp; Versand"/>
                    </VBox>
                </VBox>
            </HBox>

            <!-- ═══════════════════════════════════════════════════════
                 HAUPTLAYOUT: Bild-Spalte | Konfigurations-Panel
                 ═══════════════════════════════════════════════════════ -->
            <HBox
                class="sapUiMediumMarginBeginEnd sapUiMediumMarginBottom rsDetailLayout"
                alignItems="Start"
                wrap="Wrap">

                <!-- ─── Bild-Spalte ────────────────────────────────── -->
                <VBox class="rsDetailImageColumn sapUiSmallMarginEnd">
                    <!-- Thumbnail-Leiste (leer – bei Bedarf per Controller befüllbar) -->
                    <VBox id="thumbnailContainer" class="rsDetailImageThumbs"/>

                    <!-- Hauptbild -->
                    <Panel class="rsDetailMainImagePanel">
                        <Image
                            id="mainProductImage"
                            src="{ProductPictureUrl}"
                            width="100%"
                            class="rsDetailMainImage"
                            error="onImageError"/>
                    </Panel>
                </VBox>

                <!-- ─── Konfigurations-Panel ───────────────────────── -->
                <Panel class="rsDetailConfigPanel" backgroundDesign="Transparent">
                    <headerToolbar>
                        <Toolbar>
                            <Title text="Konfiguration &amp; Bestellung" level="H4"/>
                        </Toolbar>
                    </headerToolbar>
                    <content>
                        <VBox class="sapUiSmallMarginBeginEnd sapUiSmallMarginBottom">

                            <!-- Preisübersicht -->
                            <HBox justifyContent="SpaceBetween" class="sapUiSmallMarginTop">
                                <Text text="Grundpreis (netto)"/>
                                <Title id="basePriceText" text="{
                                    parts: [
                                        { path: 'NetPriceAmount' },
                                        { path: 'TransactionCurrency' }
                                    ],
                                    formatter: '.formatter.formatPrice'
                                }" level="H5" class="rsPriceHighlight"/>
                            </HBox>

                            <!-- CTA Buttons -->
                            <Button
                                id="addToCartBtn"
                                text="In den Warenkorb"
                                type="Emphasized"
                                icon="sap-icon://cart"
                                enabled="{= ${addToShoppingCart_ac} !== false}"
                                press="onAddToCart"
                                width="100%"
                                class="sapUiSmallMarginTop rsCartBtn"/>

                            <!-- Lieferinfos -->
                            <VBox class="sapUiSmallMarginTop rsDeliveryInfo">
                                <HBox alignItems="Center" class="sapUiTinyMarginBottom">
                                    <core:Icon src="sap-icon://accept" color="Positive" class="sapUiTinyMarginEnd"/>
                                    <Text text="Auf Lager — Lieferung in 3–5 Werktagen"/>
                                </HBox>
                                <HBox alignItems="Center" class="sapUiTinyMarginBottom">
                                    <core:Icon src="sap-icon://shipping-status" class="sapUiTinyMarginEnd"/>
                                    <Text text="Kostenloser Versand (Spedition)"/>
                                </HBox>
                                <HBox alignItems="Center" class="sapUiTinyMarginBottom">
                                    <core:Icon src="sap-icon://wrench" class="sapUiTinyMarginEnd"/>
                                    <Text text="Inbetriebnahme durch Techniker buchbar"/>
                                </HBox>
                                <HBox alignItems="Center">
                                    <core:Icon src="sap-icon://locked" class="sapUiTinyMarginEnd"/>
                                    <Text text="2 Jahre Herstellergarantie"/>
                                </HBox>
                            </VBox>

                        </VBox>
                    </content>
                </Panel>
            </HBox>

            <!-- ═══════════════════════════════════════════════════════
                 TABS: Beschreibung | Downloads
                 ═══════════════════════════════════════════════════════ -->
            <VBox class="sapUiMediumMarginBeginEnd sapUiMediumMarginBottom">
                <IconTabBar id="productTabs" expanded="true" selectedKey="desc">
                    <items>
                        <IconTabFilter text="Beschreibung" key="desc">
                            <VBox class="sapUiSmallMarginTop">
                                <Text
                                    id="productDescription"
                                    text="{= ${ProductSalesDescription} ? ${ProductSalesDescription} : 'Keine Beschreibung verfügbar.'}"
                                    wrapping="true"
                                    class="sapUiSmallMarginBottom"/>
                            </VBox>
                        </IconTabFilter>
                        <IconTabFilter text="Downloads" key="downloads">
                            <VBox class="sapUiSmallMarginTop">
                                <HBox alignItems="Center" class="sapUiSmallMarginBottom">
                                    <core:Icon src="sap-icon://pdf-attachment" size="1.5rem" class="sapUiSmallMarginEnd"/>
                                    <Link text="Datenblatt (PDF)" press="onDownload"/>
                                </HBox>
                                <HBox alignItems="Center" class="sapUiSmallMarginBottom">
                                    <core:Icon src="sap-icon://pdf-attachment" size="1.5rem" class="sapUiSmallMarginEnd"/>
                                    <Link text="Betriebsanleitung (PDF)" press="onDownload"/>
                                </HBox>
                                <HBox alignItems="Center">
                                    <core:Icon src="sap-icon://excel-attachment" size="1.5rem" class="sapUiSmallMarginEnd"/>
                                    <Link text="CAD-Daten (STEP)" press="onDownload"/>
                                </HBox>
                            </VBox>
                        </IconTabFilter>
                    </items>
                </IconTabBar>
            </VBox>

            <!-- ═══════════════════════════════════════════════════════
                 BUNDLE-KOMPONENTEN  (nur bei Stückliste)
                 ═══════════════════════════════════════════════════════ -->
            <VBox
                id="bundleSection"
                class="sapUiMediumMarginBeginEnd sapUiMediumMarginBottom"
                visible="{detailModel>/hasBundleItems}">

                <Title
                    text="Bundle-Komponenten"
                    level="H3"
                    class="sapUiSmallMarginBottom"/>
                <Text
                    text="Dieses Produkt enthält folgende Komponenten:"
                    class="sapUiSmallMarginBottom"/>

                <List
                    id="bundleGrid"
                    items="{to_BundleItem}"
                    mode="None"
                    showNoData="false"
                    class="rsBundleGrid">

                    <CustomListItem type="Active" press="onBundleItemPress">
                        <VBox class="rsBundleCard">
                            <VBox class="rsBundleCardImageWrap">
                                <Image
                                    src="{ProductPictureUrl}"
                                    width="100%"
                                    error="onBundleImageError"/>
                            </VBox>
                            <VBox class="rsBundleCardBody">
                                <VBox class="rsProductCardTitle">
                                    <Title text="{ComponentDescription}" level="H6" wrapping="true"/>
                                </VBox>
                                <VBox class="rsProductCardId">
                                    <Text text="{BillOfMaterialComponent}"/>
                                </VBox>
                            </VBox>
                        </VBox>
                    </CustomListItem>
                </List>
            </VBox>

        </content>
    </Page>
</mvc:View>
