<mvc:View
    controllerName="com.sapwebshop2026.sapwebshop.controller.ProductList"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    displayBlock="true">

    <Page id="productListPage" showHeader="true" backgroundDesign="Solid">

        <!-- SHELL BAR  (orientiert am ReferenceProject rsShellBar) -->
        <customHeader>
            <Bar class="rsShellBar">
                <contentLeft>
                    <Button
                        icon="sap-icon://home"
                        text="{i18n>shopName}"
                        type="Transparent"
                        press="onNavHome"
                        class="rsShellLogoBtn"/>
                </contentLeft>
                <contentMiddle>
                    <SearchField
                        id="searchField"
                        placeholder="{i18n>searchPlaceholder}"
                        width="400px"
                        liveChange="onSearchLive"
                        search="onSearch"
                        class="rsShellSearch"/>
                </contentMiddle>
                <contentRight>
                    <Button
                        icon="sap-icon://cart"
                        type="Transparent"
                        tooltip="{i18n>cartTooltip}"
                        press="onNavToCart"
                        class="rsShellBtn">
                        <customData>
                            <BadgeCustomData value="{= ${cartModel>/count} > 0 ? ${cartModel>/count} : ''}"/>
                        </customData>
                    </Button>
                </contentRight>
            </Bar>
        </customHeader>

        <!-- HAUPTINHALT:  Filter-Sidebar  |  Produktgrid -->
        <content>
            <HBox class="rsProductListLayout" alignItems="Start">

                <!-- LINKE SIDEBAR -->
                <VBox
                    id="filterPanel"
                    class="rsFilterPanel sapUiMediumMarginTop sapUiMediumMarginBegin">

                    <!-- Katalog-Chips (werden per Controller aus /Catalog geladen) -->
                    <Title text="{i18n>filterCategory}" level="H5" class="rsFilterPanelTitle sapUiSmallMarginBottom"/>
                    <HBox id="categoryBar" wrap="Wrap" class="rsCategoryRow sapUiSmallMarginBottom">
                        <Button
                            id="btnAllCategories"
                            text="{i18n>filterAll}"
                            type="Transparent"
                            press="onAllCatalogsPress"
                            class="rsCategoryPill rsCategoryPillActive"/>
                    </HBox>

                    <!-- Trennlinie -->
                    <HBox class="sapUiMediumMarginTopBottom rsFilterDivider"/>

                    <!-- Preisfilter -->
                    <Title text="{i18n>filterPrice}" level="H5" class="rsFilterPanelTitle sapUiSmallMarginBottom"/>
                    <HBox alignItems="Center" class="rsPriceInputs sapUiSmallMarginBottom">
                        <Input
                            id="priceMinInput"
                            type="Number"
                            placeholder="{i18n>priceFrom}"
                            change="onPriceInputChange"
                            submit="onPriceInputChange"
                            class="rsPriceInput"/>
                        <Text text="–" class="sapUiTinyMarginBegin sapUiTinyMarginEnd"/>
                        <Input
                            id="priceMaxInput"
                            type="Number"
                            placeholder="{i18n>priceTo}"
                            change="onPriceInputChange"
                            submit="onPriceInputChange"
                            class="rsPriceInput"/>
                    </HBox>
                    <CheckBox
                        id="cbOnlyPriced"
                        text="{i18n>onlyPriced}"
                        select="onTogglePriced"/>

                    <!-- Trennlinie -->
                    <HBox class="sapUiMediumMarginTopBottom rsFilterDivider"/>

                    <!-- Filter zurücksetzen -->
                    <Button
                        text="{i18n>resetFilters}"
                        type="Transparent"
                        press="onResetFilters"/>
                </VBox>

                <!-- RECHTS: Ergebnis + Produktgrid -->
                <VBox
                    class="rsProductListContent sapUiMediumMarginTop sapUiMediumMarginBeginEnd"
                    width="100%">

                    <!-- Ergebnis-Bar: Titel + Anzahl links, Sortierung rechts -->
                    <HBox
                        justifyContent="SpaceBetween"
                        alignItems="Center"
                        class="rsResultBar">
                        <VBox>
                            <Title text="{i18n>products}" level="H4" class="rsResultBarTitle"/>
                            <Text id="resultCountText" text="" class="rsResultCountText"/>
                        </VBox>
                        <HBox alignItems="Center" class="rsResultBarSort">
                            <Text text="{i18n>sortBy}" class="rsResultSortLabel sapUiTinyMarginEnd"/>
                            <Select id="sortSelect" change="onSort" width="200px">
                                <core:Item key="ProductName-asc"     text="{i18n>sortNameAsc}"/>
                                <core:Item key="ProductName-desc"    text="{i18n>sortNameDesc}"/>
                                <core:Item key="NetPriceAmount-asc"  text="{i18n>sortPriceAsc}"/>
                                <core:Item key="NetPriceAmount-desc" text="{i18n>sortPriceDesc}"/>
                            </Select>
                        </HBox>
                    </HBox>

                    <!-- Produktkacheln  (sap.m.List mit CSS-Grid via .rsProductGrid) -->
                    <List
                        id="productGrid"
                        items="{
                            path: '/CatalogItem',
                            parameters: { operationMode: 'Server' }
                        }"
                        mode="None"
                        noDataText="{i18n>noProducts}"
                        busyIndicatorDelay="0"
                        growing="true"
                        growingThreshold="24"
                        growingScrollToLoad="true"
                        updateFinished="onListUpdateFinished"
                        class="rsProductGrid">

                        <CustomListItem type="Active" press="onProductPress">

                            <!-- rsProductCard liegt auf dem inneren VBox, nicht auf dem LI,
                                 damit die CSS-Flex-Column korrekt funktioniert -->
                            <VBox class="rsProductCard">

                                <!-- Bild-Bereich -->
                                <VBox class="rsProductCardImageWrap">
                                    <Image
                                        src="{ProductPictureUrl}"
                                        width="100%"
                                        error="onImageError"/>
                                </VBox>

                                <!-- Karten-Body -->
                                <VBox class="rsProductCardBody">

                                    <!-- Titel-Wrapper → CSS .rsProductCardTitle .sapMTitle -->
                                    <VBox class="rsProductCardTitle">
                                        <Title
                                            text="{ProductName}"
                                            level="H5"
                                            wrapping="true"/>
                                    </VBox>

                                    <!-- Artikelnummer-Wrapper → CSS .rsProductCardId .sapMText -->
                                    <VBox class="rsProductCardId">
                                        <Text text="{= ${i18n>articleNo} + ' ' + ${Material}}"/>
                                    </VBox>

                                    <!-- Preis-Wrapper → CSS .rsProductPrice .sapMText -->
                                    <VBox class="rsProductPrice sapUiTinyMarginTop">
                                        <Text text="{
                                            parts: [
                                                { path: 'NetPriceAmount' },
                                                { path: 'TransactionCurrency' }
                                            ],
                                            formatter: '.formatter.formatPrice'
                                        }"/>
                                    </VBox>

                                    <!-- In den Warenkorb -->
                                    <Button
                                        text="{i18n>addToCartFull}"
                                        icon="sap-icon://cart"
                                        type="Emphasized"
                                        enabled="{addToShoppingCart_ac}"
                                        press="onAddToCart"
                                        width="100%"
                                        class="rsAddToCartBtn"/>

                                </VBox>
                            </VBox>
                        </CustomListItem>
                    </List>
                </VBox>

            </HBox>
        </content>
    </Page>
</mvc:View>
