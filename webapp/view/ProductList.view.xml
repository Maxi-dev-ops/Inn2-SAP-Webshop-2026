<mvc:View
    controllerName="com.sapwebshop2026.sapwebshop.controller.ProductList"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    displayBlock="true">

    <Page id="productListPage" showHeader="true" backgroundDesign="Solid">

        <!-- Shell bar -->
        <customHeader>
            <Bar class="rsShellBar">
                <contentLeft>
                    <Button
                        icon="sap-icon://home"
                        text="{i18n>shopName}"
                        type="Transparent"
                        press="onNavHome"
                        class="rsShellLogoBtn"/>
                </contentLeft>
                <contentMiddle>
                    <core:InvisibleText id="plpSearchLabel" text="{i18n>searchAriaLabel}"/>
                    <SearchField
                        id="searchField"
                        placeholder="{i18n>searchPlaceholder}"
                        tooltip="{i18n>searchAriaLabel}"
                        ariaLabelledBy="plpSearchLabel"
                        width="400px"
                        liveChange="onSearchLive"
                        search="onSearch"
                        class="rsShellSearch"/>
                </contentMiddle>
                <contentRight>
                    <core:Fragment fragmentName="com.sapwebshop2026.sapwebshop.view.ShellBarRight" type="XML"/>
                </contentRight>
            </Bar>
        </customHeader>

        <!-- Main content: Filter sidebar | Product grid -->
        <content>
            <HBox class="rsProductListLayout" alignItems="Start">

                <!-- Filter sidebar -->
                <VBox
                    id="filterPanel"
                    class="rsFilterPanel sapUiMediumMarginTop sapUiMediumMarginBegin">

                    <!-- Catalog chips -->
                    <Title text="{i18n>filterCategory}" level="H5" class="rsFilterPanelTitle sapUiSmallMarginBottom"/>
                    <HBox id="categoryBar" wrap="Wrap" class="rsCategoryRow sapUiSmallMarginBottom" items="{plpView>/categoryChips}">
                        <Button
                            text="{plpView>title}"
                            type="Transparent"
                            press="onCategoryChipPress"
                            class="rsCategoryPill"/>
                    </HBox>

                    <!-- Divider -->
                    <HBox class="sapUiMediumMarginTopBottom rsFilterDivider"/>

                    <!-- Price filter -->
                    <Title text="{i18n>filterPrice}" level="H5" class="rsFilterPanelTitle sapUiSmallMarginBottom"/>
                    <HBox alignItems="Center" class="rsPriceInputs sapUiSmallMarginBottom">
                        <Input
                            id="priceMinInput"
                            type="Number"
                            placeholder="{i18n>priceFrom}"
                            change="onPriceInputChange"
                            submit="onPriceInputChange"
                            class="rsPriceInput"/>
                        <Text text="–" class="sapUiTinyMarginBegin sapUiTinyMarginEnd"/>
                        <Input
                            id="priceMaxInput"
                            type="Number"
                            placeholder="{i18n>priceTo}"
                            change="onPriceInputChange"
                            submit="onPriceInputChange"
                            class="rsPriceInput"/>
                    </HBox>
                    <CheckBox
                        id="cbOnlyPriced"
                        text="{i18n>onlyPriced}"
                        select="onTogglePriced"/>

                    <!-- Divider -->
                    <HBox class="sapUiMediumMarginTopBottom rsFilterDivider"/>

                    <!-- Reset filters -->
                    <Button
                        text="{i18n>resetFilters}"
                        type="Transparent"
                        press="onResetFilters"/>
                </VBox>

                <!-- Right: Results + product grid -->
                <VBox
                    class="rsProductListContent sapUiMediumMarginTop sapUiMediumMarginBeginEnd"
                    width="100%">

                    <!-- Result bar -->
                    <HBox
                        justifyContent="SpaceBetween"
                        alignItems="Center"
                        class="rsResultBar">
                        <VBox>
                            <Title text="{i18n>products}" level="H4" class="rsResultBarTitle"/>
                            <Text id="resultCountText" text="" class="rsResultCountText"/>
                        </VBox>
                        <HBox alignItems="Center" class="rsResultBarSort">
                            <Text text="{i18n>sortBy}" class="rsResultSortLabel sapUiTinyMarginEnd"/>
                            <Select id="sortSelect" change="onSort" width="200px">
                                <core:Item key="ProductName-asc"     text="{i18n>sortNameAsc}"/>
                                <core:Item key="ProductName-desc"    text="{i18n>sortNameDesc}"/>
                                <core:Item key="NetPriceAmount-asc"  text="{i18n>sortPriceAsc}"/>
                                <core:Item key="NetPriceAmount-desc" text="{i18n>sortPriceDesc}"/>
                            </Select>
                        </HBox>
                    </HBox>

                    <!-- Product cards -->
                    <List
                        id="productGrid"
                        items="{
                            path: '/CatalogItem',
                            parameters: {
                                operationMode: 'Server',
                                select: 'CatalogItemUuid,ProductName,Material,NetPriceAmount,TransactionCurrency,ProductPictureUrl,CatalogUuid,addToShoppingCart_ac'
                            },
                            events: {
                                dataReceived: '.onProductDataReceived'
                            }
                        }"
                        mode="None"
                        busyIndicatorDelay="0"
                        growing="true"
                        growingThreshold="24"
                        growingScrollToLoad="true"
                        updateFinished="onListUpdateFinished"
                        class="rsProductGrid">

                        <noData>
                            <IllustratedMessage
                                illustrationType="sapIllus-NoData"
                                illustrationSize="Auto"
                                title="{i18n>noProducts}"/>
                        </noData>

                        <CustomListItem type="Active" press="onProductPress">

                            <VBox class="rsProductCard">

                                <VBox class="rsProductCardImageWrap">
                                    <Image
                                        src="{ProductPictureUrl}"
                                        alt="{ProductName}"
                                        tooltip="{ProductName}"
                                        width="100%"
                                        error="onImageError"/>
                                    <Button
                                        icon="sap-icon://heart-2"
                                        type="Transparent"
                                        tooltip="{i18n>wishlist}"
                                        press="onToggleWishlist"
                                        class="rsCardHeartBtn"/>
                                </VBox>

                                <!-- Card body -->
                                <VBox class="rsProductCardBody">
                                    <VBox class="rsProductCardTitle">
                                        <Title
                                            text="{ProductName}"
                                            level="H5"
                                            wrapping="true"/>
                                    </VBox>
                                    <VBox class="rsProductCardId">
                                        <Text text="{= ${i18n>articleNo} + ' ' + ${Material}}"/>
                                    </VBox>
                                    <VBox class="rsProductPrice sapUiTinyMarginTop">
                                        <Text text="{
                                            parts: [
                                                { path: 'NetPriceAmount' },
                                                { path: 'TransactionCurrency' }
                                            ],
                                            formatter: '.formatter.formatPrice'
                                        }"/>
                                    </VBox>
                                    <Button
                                        text="{i18n>addToCartFull}"
                                        icon="sap-icon://cart"
                                        type="Emphasized"
                                        enabled="{= ${addToShoppingCart_ac} !== false}"
                                        press="onOpenCartDialog"
                                        width="100%"
                                        class="rsAddToCartBtn sapUiTinyMarginTop"/>

                                </VBox>
                            </VBox>
                        </CustomListItem>
                    </List>

                    <!-- Custom empty state (visible when filters are active and no results) -->
                    <VBox
                        id="emptyResultState"
                        visible="false"
                        class="rsEmptyResultState"
                        alignItems="Center"
                        justifyContent="Center">
                        <IllustratedMessage
                            illustrationType="sapIllus-NoSearchResults"
                            illustrationSize="Auto"
                            title="{i18n>noResultsTitle}"
                            description="{i18n>noResultsHint}">
                            <additionalContent>
                                <Button
                                    text="{i18n>resetFilters}"
                                    type="Emphasized"
                                    press="onResetFilters"/>
                            </additionalContent>
                        </IllustratedMessage>
                    </VBox>
                </VBox>

            </HBox>
        </content>
    </Page>
</mvc:View>
