<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core">
    <Button
        icon="sap-icon://nav-back"
        type="Transparent"
        tooltip="{i18n>back}"
        press="onNavBack"
        class="rsShellBtn"/>
