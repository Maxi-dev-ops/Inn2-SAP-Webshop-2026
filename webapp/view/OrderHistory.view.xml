<mvc:View
    controllerName="com.sapwebshop2026.sapwebshop.controller.OrderHistory"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    displayBlock="true">

    <Page id="orderHistoryPage" showHeader="true" backgroundDesign="Solid">

        <!-- Shell bar -->
        <customHeader>
            <Bar class="rsShellBar">
                <contentLeft>
                    <core:Fragment fragmentName="com.sapwebshop2026.sapwebshop.view.ShellBarLeftNav" type="XML"/>
                </contentLeft>
                <contentMiddle>
                    <Title text="{i18n>orderHistoryTitle}" level="H4" class="rsShellTitle"/>
                </contentMiddle>
                <contentRight>
                    <core:Fragment fragmentName="com.sapwebshop2026.sapwebshop.view.ShellBarRight" type="XML"/>
                </contentRight>
            </Bar>
        </customHeader>

        <content>
            <VBox class="sapUiMediumMarginBeginEnd sapUiMediumMarginTop">

                <!-- Empty state -->
                <VBox
                    visible="{orderHistoryModel>/showEmpty}"
                    class="rsOrderHistoryEmpty"
                    alignItems="Center">
                    <IllustratedMessage
                        illustrationType="sapIllus-NoEntries"
                        illustrationSize="Auto"
                        title="{i18n>orderHistoryEmpty}"
                        description="{i18n>orderHistoryEmptyHint}"/>
                </VBox>

                <!-- Order list -->
                <List
                    id="orderList"
                    items="{orderHistoryModel>/orders}"
                    visible="{orderHistoryModel>/showList}"
                    showSeparators="None"
                    mode="None">
                    <CustomListItem type="Inactive" class="rsOrderCard">
                        <VBox class="rsOrderCardInner">

                            <HBox justifyContent="SpaceBetween" alignItems="Center">
                                <VBox>
                                    <Title text="{orderHistoryModel>uuid}" level="H5" class="rsOrderUuid"/>
                                    <HBox alignItems="Center" class="sapUiTinyMarginTop">
                                        <core:Icon src="sap-icon://calendar" class="sapUiTinyMarginEnd rsOrderDateIcon"/>
                                        <Text text="{orderHistoryModel>date}" class="rsOrderDate"/>
                                    </HBox>
                                </VBox>
                                <ObjectStatus
                                    text="{
                                        path: 'orderHistoryModel>status',
                                        formatter: '.formatOrderStatus'
                                    }"
                                    state="{
                                        path: 'orderHistoryModel>status',
                                        formatter: '.formatOrderStatusState'
                                    }"
                                    inverted="true"/>
                            </HBox>

                            <!-- Summary: item count + total -->
                            <HBox justifyContent="SpaceBetween" alignItems="Center" class="rsOrderSummaryRow sapUiSmallMarginTop">
                                <HBox alignItems="Center">
                                    <core:Icon src="sap-icon://cart" class="sapUiTinyMarginEnd rsOrderSummaryIcon"/>
                                    <Text text="{= ${orderHistoryModel>itemCount} + ' ' + ${i18n>orderItems}}"/>
                                </HBox>
                                <Text
                                    text="{
                                        parts: [
                                            { path: 'orderHistoryModel>totalAmount' },
                                            { path: 'orderHistoryModel>currency' }
                                        ],
                                        formatter: '.formatter.formatPrice'
                                    }"
                                    class="rsOrderTotal"/>
                            </HBox>

                            <!-- Details toggle -->
                            <Button
                                text="{
                                    path: 'orderHistoryModel>expanded',
                                    formatter: '.formatToggleText'
                                }"
                                icon="{
                                    path: 'orderHistoryModel>expanded',
                                    formatter: '.formatToggleIcon'
                                }"
                                type="Transparent"
                                press="onToggleOrderDetails"
                                class="rsOrderToggleBtn sapUiTinyMarginTop"/>

                            <!-- Collapsible item list -->
                            <VBox visible="{orderHistoryModel>expanded}" class="rsOrderItemList">
                                <List
                                    items="{orderHistoryModel>items}"
                                    showSeparators="None"
                                    mode="None"
                                    class="sapUiNoContentPadding">
                                    <CustomListItem type="Inactive">
                                        <HBox alignItems="Center" justifyContent="SpaceBetween" class="rsOrderItem">
                                            <VBox class="rsOrderItemInfo">
                                                <Text text="{orderHistoryModel>name}" class="rsOrderItemName"/>
                                                <Text
                                                    text="{= ${i18n>articleNo} + ' ' + ${orderHistoryModel>material}}"
                                                    class="rsOrderItemId sapUiTinyMarginTop"/>
                                            </VBox>
                                            <VBox alignItems="End">
                                                <Text
                                                    text="{
                                                        parts: [
                                                            { path: 'orderHistoryModel>price' },
                                                            { path: 'orderHistoryModel>currency' },
                                                            { path: 'orderHistoryModel>quantity' }
                                                        ],
                                                        formatter: '.formatter.formatLinePrice'
                                                    }"
                                                    class="rsOrderItemPrice"/>
                                                <Text
                                                    visible="{= ${orderHistoryModel>quantity} > 1}"
                                                    text="{
                                                        parts: [
                                                            { path: 'orderHistoryModel>price' },
                                                            { path: 'orderHistoryModel>currency' },
                                                            { path: 'orderHistoryModel>quantity' }
                                                        ],
                                                        formatter: '.formatter.formatUnitLine'
                                                    }"
                                                    class="rsCartUnitLine"/>
                                            </VBox>
                                        </HBox>
                                    </CustomListItem>
                                </List>
                            </VBox>

                        </VBox>
                    </CustomListItem>
                </List>

            </VBox>
        </content>
    </Page>
</mvc:View>
