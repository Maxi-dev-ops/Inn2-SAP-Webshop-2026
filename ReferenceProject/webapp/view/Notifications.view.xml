<mvc:View controllerName="sapwebshop.controller.Notifications"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    displayBlock="true">

    <Page id="notificationsPage" showHeader="true" backgroundDesign="Solid">
        <customHeader>
            <Bar class="rsShellBar">
                <contentLeft>
                    <Button icon="sap-icon://nav-back" type="Transparent" tooltip="Zurück" press="onNavBack" class="rsShellBtn" />
                    <Button icon="sap-icon://sap-logo-shape" text="RoboShop | Robotics Webshop" type="Transparent" press="onNavHome" class="rsShellLogoBtn" />
                </contentLeft>
                <contentMiddle>
                    <SearchField placeholder="Produkte suchen..." width="400px" search="onSearch" class="rsShellSearch" />
                </contentMiddle>
                <contentRight>
                    <Button icon="sap-icon://bell" type="Emphasized" tooltip="Benachrichtigungen" press="onNotificationsPress" class="rsShellBtn" />
                    <Button icon="sap-icon://cart" type="Transparent" tooltip="Warenkorb" press="onCartPress" class="rsShellBtn">
                        <customData>
                            <BadgeCustomData value="{= ${cart>/totalCount} > 0 ? ${cart>/totalCount} : ''}" />
                        </customData>
                    </Button>
                    <Button icon="sap-icon://heart" type="Transparent" tooltip="Wunschliste" press="onWishlistPress" class="rsShellBtn" />
                    <Avatar initials="MM" displaySize="XS" tooltip="Benutzerprofil" press="onUserPress" class="sapUiTinyMarginBegin rsShellAvatar" backgroundColor="Accent5" />
                </contentRight>
            </Bar>
        </customHeader>

        <content>
            <HBox class="sapUiMediumMarginBeginEnd sapUiSmallMarginBottom sapUiSmallMarginTop" justifyContent="SpaceBetween" alignItems="Center">
                <Title text="Benachrichtigungen" level="H2" />
                <Button text="Alle gelesen" icon="sap-icon://accept" type="Transparent" press="onMarkAllRead" />
            </HBox>

            <!-- Tabs: All / Unread / Orders -->
            <IconTabBar id="notifTabs" class="sapUiMediumMarginBeginEnd" select="onTabSelect" expanded="true">
                <items>
                    <IconTabFilter text="Alle" key="all" count="3" />
                    <IconTabFilter text="Ungelesen" key="unread" count="3" iconColor="Critical" />
                    <IconTabFilter text="Bestellungen" key="orders" count="1" />
                    <IconTabFilter text="System" key="system" count="2" />
                </items>
            </IconTabBar>

            <!-- Notification List -->
            <VBox id="notifContainer" class="sapUiMediumMarginBeginEnd sapUiSmallMarginBottom">
                <!-- Unread: new order -->
                <Panel class="rsNotifCard rsNotifUnread" backgroundDesign="Transparent">
                    <content>
                        <HBox alignItems="Start" class="rsNotifRow">
                            <core:Icon src="sap-icon://document" size="1.5rem" color="#0064d9" class="rsNotifIcon" />
                            <VBox class="rsNotifBody">
                                <Title text="Bestellung BE-2026-47291 versandt" level="H6" />
                                <Text text="Ihre Bestellung wurde heute um 09:14 Uhr versandt. Voraussichtliche Lieferung: 12. Mai 2026." wrapping="true" class="sapUiTinyMarginTop" />
                                <Text text="Vor 2 Stunden" class="rsNotifTime" />
                            </VBox>
                            <Button icon="sap-icon://decline" type="Transparent" tooltip="Entfernen" press="onDismissNotif" class="rsNotifDismiss" />
                        </HBox>
                    </content>
                </Panel>

                <!-- Unread: price alert -->
                <Panel class="rsNotifCard rsNotifUnread" backgroundDesign="Transparent">
                    <content>
                        <HBox alignItems="Start" class="rsNotifRow">
                            <core:Icon src="sap-icon://tag" size="1.5rem" color="#e9730c" class="rsNotifIcon" />
                            <VBox class="rsNotifBody">
                                <Title text="Preisalarm: HeavyLifter H12" level="H6" />
                                <Text text="Der HeavyLifter H12 auf Ihrer Wunschliste ist jetzt 8% günstiger — nur noch € 78.100,00." wrapping="true" class="sapUiTinyMarginTop" />
                                <Text text="Vor 5 Stunden" class="rsNotifTime" />
                            </VBox>
                            <Button icon="sap-icon://decline" type="Transparent" tooltip="Entfernen" press="onDismissNotif" class="rsNotifDismiss" />
                        </HBox>
                    </content>
                </Panel>

                <!-- Unread: system -->
                <Panel class="rsNotifCard rsNotifUnread" backgroundDesign="Transparent">
                    <content>
                        <HBox alignItems="Start" class="rsNotifRow">
                            <core:Icon src="sap-icon://sys-help" size="1.5rem" color="#107e3e" class="rsNotifIcon" />
                            <VBox class="rsNotifBody">
                                <Title text="Wartungsfenster geplant" level="H6" />
                                <Text text="Am 10. Mai 2026 von 02:00–04:00 Uhr ist der Shop kurzzeitig nicht verfügbar." wrapping="true" class="sapUiTinyMarginTop" />
                                <Text text="Gestern" class="rsNotifTime" />
                            </VBox>
                            <Button icon="sap-icon://decline" type="Transparent" tooltip="Entfernen" press="onDismissNotif" class="rsNotifDismiss" />
                        </HBox>
                    </content>
                </Panel>
            </VBox>
        </content>
    </Page>
</mvc:View>
