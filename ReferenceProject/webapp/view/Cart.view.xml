<mvc:View controllerName="sapwebshop.controller.Cart"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    displayBlock="true">

    <Page id="cartPage" showHeader="true" backgroundDesign="Solid">
        <customHeader>
            <Bar class="rsShellBar">
                <contentLeft>
                    <Button icon="sap-icon://nav-back" type="Transparent" tooltip="Zurück" press="onNavBack" class="rsShellBtn" />
                    <Button icon="sap-icon://sap-logo-shape" text="RoboShop | Robotics Webshop" type="Transparent" press="onNavHome" class="rsShellLogoBtn" />
                </contentLeft>
                <contentMiddle>
                    <SearchField placeholder="Produkte suchen..." width="400px" search="onSearch" class="rsShellSearch" />
                </contentMiddle>
                <contentRight>
                    <Button icon="sap-icon://bell" type="Transparent" tooltip="Benachrichtigungen" press="onNotificationsPress" class="rsShellBtn" />
                    <Button icon="sap-icon://cart" type="Emphasized" tooltip="Warenkorb" press="onCartPress" class="rsShellBtn" />
                    <Button icon="sap-icon://heart" type="Transparent" tooltip="Wunschliste" press="onWishlistPress" class="rsShellBtn" />
                    <Avatar initials="MM" displaySize="XS" tooltip="Benutzerprofil" press="onUserPress" class="sapUiTinyMarginBegin rsShellAvatar" backgroundColor="Accent5" />
                </contentRight>
            </Bar>
        </customHeader>

        <content>
            <HBox class="sapUiMediumMarginBeginEnd sapUiSmallMarginBottom sapUiSmallMarginTop" justifyContent="SpaceBetween" alignItems="Center">
                <Title id="cartTitle" text="Warenkorb" level="H2" />
                <Button text="Warenkorb leeren" icon="sap-icon://delete" type="Transparent" press="onClearCart" />
            </HBox>

            <HBox class="sapUiMediumMarginBeginEnd sapUiMediumMarginBottom" alignItems="Start" wrap="Wrap">
                <!-- Cart Items -->
                <VBox class="rsCartItemsColumn sapUiSmallMarginEnd">
                    <!-- Voucher — above the product list -->
                    <Panel class="rsVoucherPanel sapUiSmallMarginBottom" backgroundDesign="Transparent">
                        <headerToolbar>
                            <Toolbar height="auto">
                                <core:Icon src="sap-icon://tag" class="sapUiTinyMarginEnd" />
                                <Title text="Gutscheincode" level="H5" />
                            </Toolbar>
                        </headerToolbar>
                        <content>
                            <HBox class="sapUiTinyMarginTop" alignItems="Center">
                                <Input id="voucherInput" placeholder="Code eingeben..." width="280px" class="sapUiSmallMarginEnd" />
                                <Button text="Einlösen" type="Default" press="onRedeemVoucher" />
                            </HBox>
                        </content>
                    </Panel>

                    <!-- Product list -->
                    <List id="cartList" noDataText="Ihr Warenkorb ist leer."
                        items="{cart>/items}" showSeparators="None">
                        <CustomListItem class="rsCartListItem">
                            <HBox alignItems="Center" class="rsCartItem">
                                <Image src="{cart>image}" width="90px" height="90px" class="rsCartItemImage sapUiSmallMarginEnd" />
                                <VBox class="rsCartItemInfo" width="100%">
                                    <HBox justifyContent="SpaceBetween" alignItems="Start">
                                        <VBox>
                                            <Title text="{cart>name}" level="H5" />
                                            <Text text="Art.-Nr.: {cart>id} | {cart>manufacturer}" class="rsProductCardId" />
                                            <Text text="Variante: {cart>variant} | Controller: {cart>controller}" class="rsProductCardId sapUiTinyMarginBottom" />
                                            <ObjectStatus text="{cart>availability}" state="Success" />
                                        </VBox>
                                        <Title text="{parts: [{path: 'cart>totalPrice'}], formatter: '.formatCurrency'}" level="H4" class="rsPriceHighlight" />
                                    </HBox>
                                    <HBox alignItems="Center" class="sapUiSmallMarginTop" justifyContent="SpaceBetween">
                                        <HBox alignItems="Center" class="rsQtyBox">
                                            <Button icon="sap-icon://less" tooltip="Menge verringern" type="Transparent" press="onDecreaseQty" />
                                            <Text text="{cart>quantity}" class="rsQtyText" />
                                            <Button icon="sap-icon://add" tooltip="Menge erhöhen" type="Transparent" press="onIncreaseQty" />
                                        </HBox>
                                        <HBox>
                                            <Button text="Merken" tooltip="Zur Wunschliste" icon="sap-icon://heart" type="Transparent" press="onMoveToWishlist" class="sapUiSmallMarginEnd" />
                                            <Button text="Entfernen" tooltip="Aus Warenkorb entfernen" icon="sap-icon://delete" type="Transparent" press="onRemoveItem" />
                                        </HBox>
                                    </HBox>
                                </VBox>
                            </HBox>
                        </CustomListItem>
                    </List>
                </VBox>

                <!-- Order Summary -->
                <Panel class="rsCartSummaryPanel" backgroundDesign="Transparent">
                    <headerToolbar>
                        <Toolbar>
                            <Title text="Bestellübersicht" level="H4" />
                        </Toolbar>
                    </headerToolbar>
                    <content>
                        <VBox class="sapUiSmallMarginBeginEnd sapUiSmallMarginBottom">
                            <List id="summaryList" showSeparators="None"
                                items="{cart>/items}">
                                <DisplayListItem
                                    label="{parts: [{path: 'cart>name'}, {path: 'cart>quantity'}], formatter: '.formatSummaryLabel'}"
                                    value="{parts: [{path: 'cart>totalPrice'}], formatter: '.formatCurrency'}" />
                            </List>

                            <HBox justifyContent="SpaceBetween" class="sapUiSmallMarginTop">
                                <Text text="Versandkosten" />
                                <Text text="Kostenlos" class="rsGreen" />
                            </HBox>
                            <HBox justifyContent="SpaceBetween" class="sapUiTinyMarginTop">
                                <Text text="MwSt. (19%)" />
                                <Text id="vatText" text="" />
                            </HBox>
                            <HBox justifyContent="SpaceBetween" class="sapUiSmallMarginTop">
                                <Title text="Gesamtbetrag" level="H4" />
                                <Title id="grandTotalText" text="" level="H4" class="rsPriceHighlight" />
                            </HBox>

                            <Button text="Zur Kasse →" type="Emphasized" press="onCheckout" width="100%" class="sapUiSmallMarginTop" />
                            <Button text="← Weiter einkaufen" type="Transparent" press="onContinueShopping" width="100%" class="sapUiTinyMarginTop" />

                            <VBox class="sapUiSmallMarginTop rsCartTrustBadges">
                                <HBox alignItems="Center" class="sapUiTinyMarginBottom">
                                    <core:Icon src="sap-icon://locked" class="sapUiTinyMarginEnd" />
                                    <Text text="SSL-verschlüsselte Verbindung" />
                                </HBox>
                                <HBox alignItems="Center" class="sapUiTinyMarginBottom">
                                    <core:Icon src="sap-icon://document" class="sapUiTinyMarginEnd" />
                                    <Text text="Kauf auf Rechnung möglich" />
                                </HBox>
                                <HBox alignItems="Center">
                                    <core:Icon src="sap-icon://undo" class="sapUiTinyMarginEnd" />
                                    <Text text="14 Tage Rückgaberecht" />
                                </HBox>
                            </VBox>
                        </VBox>
                    </content>
                </Panel>
            </HBox>
        </content>
    </Page>
</mvc:View>
