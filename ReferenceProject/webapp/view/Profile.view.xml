<mvc:View controllerName="sapwebshop.controller.Profile"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    displayBlock="true">

    <Page id="profilePage" showHeader="true" backgroundDesign="Solid">
        <customHeader>
            <Bar class="rsShellBar">
                <contentLeft>
                    <Button icon="sap-icon://nav-back" type="Transparent" tooltip="Zurück" press="onNavBack" class="rsShellBtn" />
                    <Button icon="sap-icon://sap-logo-shape" text="RoboShop | Robotics Webshop" type="Transparent" press="onNavHome" class="rsShellLogoBtn" />
                </contentLeft>
                <contentMiddle>
                    <SearchField placeholder="Produkte suchen..." width="400px" search="onSearch" class="rsShellSearch" />
                </contentMiddle>
                <contentRight>
                    <Button icon="sap-icon://bell" type="Transparent" tooltip="Benachrichtigungen" press="onNotificationsPress" class="rsShellBtn" />
                    <Button icon="sap-icon://cart" type="Transparent" tooltip="Warenkorb" press="onCartPress" class="rsShellBtn">
                        <customData>
                            <BadgeCustomData value="{= ${cart>/totalCount} > 0 ? ${cart>/totalCount} : ''}" />
                        </customData>
                    </Button>
                    <Button icon="sap-icon://heart" type="Transparent" tooltip="Wunschliste" press="onWishlistPress" class="rsShellBtn" />
                    <Avatar initials="MM" displaySize="XS" tooltip="Benutzerprofil" press="onUserPress" class="sapUiTinyMarginBegin rsShellAvatar" backgroundColor="Accent5" />
                </contentRight>
            </Bar>
        </customHeader>

        <content>
            <!-- Profile Header -->
            <Panel backgroundDesign="Transparent" class="rsProfileHeader sapUiMediumMarginBeginEnd sapUiSmallMarginBottom">
                <content>
                    <HBox alignItems="Center" class="sapUiMediumMargin">
                        <Avatar initials="MM" displaySize="L" backgroundColor="Accent5" class="sapUiMediumMarginEnd" />
                        <VBox>
                            <Title text="Max Mustermann" level="H2" />
                            <Text text="Einkaufsleiter · DATAGROUP SE" class="sapUiTinyMarginTop rsProfileRole" />
                            <Text text="max.mustermann@datagroup.de" class="sapUiTinyMarginTop" />
                            <ObjectStatus text="Konto verifiziert" state="Success" class="sapUiTinyMarginTop" />
                        </VBox>
                    </HBox>
                </content>
            </Panel>

            <!-- Quick Stats -->
            <HBox wrap="Wrap" class="sapUiMediumMarginBeginEnd sapUiSmallMarginBottom rsProfileStatsRow">
                <Panel backgroundDesign="Transparent" class="rsProfileStat">
                    <content>
                        <VBox alignItems="Center" class="sapUiSmallMargin">
                            <Title text="12" level="H2" class="rsPriceHighlight" />
                            <Text text="Bestellungen" />
                        </VBox>
                    </content>
                </Panel>
                <Panel backgroundDesign="Transparent" class="rsProfileStat">
                    <content>
                        <VBox alignItems="Center" class="sapUiSmallMargin">
                            <Title text="€ 847.300" level="H2" class="rsPriceHighlight" />
                            <Text text="Gesamtumsatz" />
                        </VBox>
                    </content>
                </Panel>
                <Panel backgroundDesign="Transparent" class="rsProfileStat">
                    <content>
                        <VBox alignItems="Center" class="sapUiSmallMargin">
                            <Title text="5" level="H2" class="rsPriceHighlight" />
                            <Text text="Auf Wunschliste" />
                        </VBox>
                    </content>
                </Panel>
            </HBox>

            <!-- Quick Navigation -->
            <Title text="Mein Konto" level="H4" class="sapUiMediumMarginBegin sapUiSmallMarginBottom sapUiSmallMarginTop" />
            <VBox class="sapUiMediumMarginBeginEnd sapUiMediumMarginBottom">
                <List showSeparators="Inner" mode="None">
                    <StandardListItem title="Bestellhistorie" icon="sap-icon://order-status" type="Active" info="12 Bestellungen" press="onOrderHistoryPress" />
                    <StandardListItem title="Wunschliste" icon="sap-icon://heart" type="Active" press="onWishlistPress" />
                    <StandardListItem title="Warenkorb" icon="sap-icon://cart" type="Active" press="onCartPress" />
                    <StandardListItem title="Support kontaktieren" icon="sap-icon://sys-help" type="Active" press="onSupportPress" />
                    <StandardListItem title="Abmelden" icon="sap-icon://log" type="Active" press="onLogout" />
                </List>
            </VBox>
        </content>
    </Page>
</mvc:View>
