<mvc:View controllerName="sapwebshop.controller.ProductList"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    displayBlock="true">

    <Page id="productListPage" showHeader="true" backgroundDesign="Solid">
        <customHeader>
            <Bar class="rsShellBar">
                <contentLeft>
                    <Button icon="sap-icon://nav-back" type="Transparent" tooltip="Zurück" press="onNavBack" class="rsShellBtn" />
                    <Button icon="sap-icon://sap-logo-shape" text="RoboShop | Robotics Webshop" type="Transparent" press="onNavHome" class="rsShellLogoBtn" />
                </contentLeft>
                <contentMiddle>
                    <SearchField id="pageSearch" placeholder="Produkte suchen..." width="400px" search="onSearch" class="rsShellSearch" />
                </contentMiddle>
                <contentRight>
                    <Button icon="sap-icon://bell" type="Transparent" tooltip="Benachrichtigungen" press="onNotificationsPress" class="rsShellBtn" />
                    <Button icon="sap-icon://cart" type="Transparent" tooltip="Warenkorb" press="onCartPress" class="rsShellBtn">
                        <customData>
                            <BadgeCustomData value="{= ${cart>/totalCount} > 0 ? ${cart>/totalCount} : ''}" />
                        </customData>
                    </Button>
                    <Button icon="sap-icon://heart" type="Transparent" tooltip="Wunschliste" press="onWishlistPress" class="rsShellBtn" />
                    <Avatar initials="MM" displaySize="XS" tooltip="Benutzerprofil" press="onUserPress" class="sapUiTinyMarginBegin rsShellAvatar" backgroundColor="Accent5" />
                </contentRight>
            </Bar>
        </customHeader>

        <content>
            <HBox class="rsProductListLayout" alignItems="Start">
                <!-- Left Filter Panel -->
                <VBox id="filterPanel" class="rsFilterPanel sapUiMediumMarginTop sapUiMediumMarginBegin">
                    <!-- Category Filter -->
                    <Title text="Kategorie" level="H5" class="sapUiSmallMarginBottom" />
                    <RadioButtonGroup id="categoryFilter" select="onCategoryFilter" class="sapUiSmallMarginBottom">
                        <buttons>
                            <RadioButton id="catAll" text="Alle" selected="true" />
                            <RadioButton id="catIndustrie" text="Industrieroboter" />
                            <RadioButton id="catKollab" text="Kollaborationsroboter" />
                            <RadioButton id="catMobile" text="Mobile Roboter" />
                            <RadioButton id="catService" text="Serviceroboter" />
                        </buttons>
                    </RadioButtonGroup>

                    <!-- Price Filter -->
                    <Title text="Preisspanne" level="H5" class="sapUiSmallMarginBottom sapUiMediumMarginTop" />
                    <Text id="priceRangeText" text="bis € 90.000" class="sapUiSmallMarginBottom" />
                    <Slider id="priceSlider" min="10000" max="90000" value="90000" step="1000" change="onPriceFilter" liveChange="onPriceLiveChange" width="90%" class="sapUiSmallMarginBottom" />

                    <!-- Manufacturer Filter -->
                    <Title text="Hersteller" level="H5" class="sapUiSmallMarginBottom sapUiMediumMarginTop" />
                    <CheckBox id="mfrKUKA" text="KUKA Robotics" select="onManufacturerFilter" />
                    <CheckBox id="mfrABB" text="ABB Robotics" select="onManufacturerFilter" />
                    <CheckBox id="mfrFANUC" text="FANUC" select="onManufacturerFilter" />
                    <CheckBox id="mfrUR" text="Universal Robots" select="onManufacturerFilter" />

                    <!-- Availability Filter -->
                    <Title text="Verfügbarkeit" level="H5" class="sapUiSmallMarginBottom sapUiMediumMarginTop" />
                    <CheckBox id="availInStock" text="Auf Lager" select="onAvailabilityFilter" />
                    <CheckBox id="availBackorder" text="Bestellbar (4–6 Wo.)" select="onAvailabilityFilter" />

                    <Button text="Filter zurücksetzen" type="Transparent" press="onResetFilters" class="sapUiMediumMarginTop" />
                </VBox>

                <!-- Product Grid -->
                <VBox class="rsProductListContent sapUiMediumMarginTop sapUiMediumMarginBeginEnd" width="100%">
                    <HBox justifyContent="SpaceBetween" alignItems="Center" class="sapUiSmallMarginBottom">
                        <Text id="resultCountText" text="Produkte gefunden" />
                        <HBox alignItems="Center">
                            <Label text="Sortierung:" class="sapUiSmallMarginEnd" />
                            <Select id="sortSelect" change="onSortChange">
                                <items>
                                    <core:Item key="featured" text="Empfohlen" />
                                    <core:Item key="priceAsc" text="Preis aufsteigend" />
                                    <core:Item key="priceDesc" text="Preis absteigend" />
                                    <core:Item key="name" text="Name A–Z" />
                                </items>
                            </Select>
                            <Button id="listViewBtn" icon="sap-icon://list" type="Transparent" press="onToggleView" class="sapUiSmallMarginBegin" />
                            <Button id="gridViewBtn" icon="sap-icon://grid" type="Emphasized" press="onToggleView" />
                        </HBox>
                    </HBox>

                    <!-- Grid View -->
                    <HBox id="productGrid" wrap="Wrap" class="rsProductGrid" />

                    <!-- List View (hidden by default) -->
                    <List id="productList" visible="false" mode="None"
                        items="{path: 'filteredProducts>/items'}">
                        <ObjectListItem
                            title="{filteredProducts>name}"
                            number="{parts: [{path: 'filteredProducts>price'}], formatter: '.formatPrice'}"
                            intro="{filteredProducts>id}"
                            type="Active"
                            press="onProductPress">
                            <attributes>
                                <ObjectAttribute text="{filteredProducts>category}" />
                                <ObjectAttribute text="{filteredProducts>manufacturer}" />
                            </attributes>
                            <firstStatus>
                                <ObjectStatus text="{filteredProducts>availability}" state="{parts: [{path: 'filteredProducts>inStock'}], formatter: '.formatStockState'}" />
                            </firstStatus>
                        </ObjectListItem>
                    </List>
                </VBox>
            </HBox>
        </content>
    </Page>
</mvc:View>
