<mvc:View controllerName="sapwebshop.controller.Wishlist"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    displayBlock="true">

    <Page id="wishlistPage" showHeader="true" backgroundDesign="Solid">
        <customHeader>
            <Bar class="rsShellBar">
                <contentLeft>
                    <Button icon="sap-icon://nav-back" type="Transparent" tooltip="Zurück" press="onNavBack" class="rsShellBtn" />
                    <Button icon="sap-icon://sap-logo-shape" text="RoboShop | Robotics Webshop" type="Transparent" press="onNavHome" class="rsShellLogoBtn" />
                </contentLeft>
                <contentMiddle>
                    <SearchField placeholder="Produkte suchen..." width="400px" search="onSearch" class="rsShellSearch" />
                </contentMiddle>
                <contentRight>
                    <Button icon="sap-icon://bell" type="Transparent" tooltip="Benachrichtigungen" press="onNotificationsPress" class="rsShellBtn" />
                    <Button icon="sap-icon://cart" type="Transparent" tooltip="Warenkorb" press="onCartPress" class="rsShellBtn">
                        <customData>
                            <BadgeCustomData value="{= ${cart>/totalCount} > 0 ? ${cart>/totalCount} : ''}" />
                        </customData>
                    </Button>
                    <Button icon="sap-icon://heart" type="Transparent" tooltip="Wunschliste" press="onWishlistPress" class="rsShellBtn" />
                    <Avatar initials="MM" displaySize="XS" tooltip="Benutzerprofil" press="onUserPress" class="sapUiTinyMarginBegin rsShellAvatar" backgroundColor="Accent5" />
                </contentRight>
            </Bar>
        </customHeader>

        <content>
            <HBox class="sapUiMediumMarginBeginEnd sapUiSmallMarginBottom sapUiSmallMarginTop" justifyContent="SpaceBetween" alignItems="Center">
                <Title id="wishlistTitle" text="Meine Wunschliste" level="H2" />
                <HBox>
                    <Button text="Alle in den Warenkorb" type="Emphasized" icon="sap-icon://cart" press="onAddAllToCart" class="sapUiSmallMarginEnd" />
                    <Button text="Liste leeren" icon="sap-icon://delete" type="Transparent" press="onClearWishlist" />
                </HBox>
            </HBox>

            <!-- Wishlist Grid -->
            <HBox id="wishlistGrid" wrap="Wrap" class="sapUiMediumMarginBeginEnd rsWishlistGrid" />

            <!-- Empty State -->
            <VBox id="emptyWishlist" visible="false" alignItems="Center" class="rsEmptyState sapUiLargeMarginTop">
                <core:Icon src="sap-icon://heart" size="4rem" color="#cccccc" />
                <Title text="Ihre Wunschliste ist leer" level="H3" class="sapUiSmallMarginTop" />
                <Text text="Speichern Sie Produkte, die Sie später kaufen möchten." class="sapUiTinyMarginTop sapUiSmallMarginBottom" />
                <Button text="Produkte entdecken" type="Emphasized" press="onDiscoverProducts" />
            </VBox>

            <!-- Recommendations -->
            <VBox id="recommendationsSection" class="sapUiMediumMarginBeginEnd sapUiMediumMarginTop sapUiMediumMarginBottom">
                <Title text="Das könnte Sie auch interessieren" level="H3" class="sapUiSmallMarginBottom" />
                <HBox id="recommendationsBox" wrap="Wrap" class="rsFeaturedRow" />
            </VBox>
        </content>
    </Page>
</mvc:View>
